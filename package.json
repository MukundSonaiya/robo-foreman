  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "keywords": [
    "cursor",
    "plugin",
    "agentic",
    "oss",
    "foreman"
  ]
}
