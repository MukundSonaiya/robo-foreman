#!/usr/bin/env bash
# Block shell ops that look like they touch secret files
set -euo pipefail
input="$(cat)"
cmd="$(printf '%s' "$input" | sed -n 's/.*"command"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
if printf '%s' "$cmd" | grep -Eqi '(\.env(\.|$)|id_rsa|\.pem|secrets?/|credentials\.json)'; then
  cat <<'EOF'
{"continue":true,"permission":"ask","user_message":"Secret-looking path in command — confirm before continuing.","agent_message":"This command references a likely secret file. Ask the user before proceeding; never print secret contents."}
EOF
  exit 0
fi
printf '%s\n' '{"continue":true,"permission":"allow"}'
exit 0
